<?xml version="1.0"?>

<robot name="firetruck_robot">
  <!--colors-->
  <material name="blue">
      <color rgba="0 0 0.8 1"/>
  </material>
  <material name="red">
      <color rgba="0.8 0 0.0 1"/>
  </material>
  <material name="transparent_red">
      <color rgba="0.8 0 0.0 0.2"/>
  </material>
  <material name="darkgrey">
      <color rgba="0.502 0.502 0.502 1.0"/>
  </material>
  <material name="lightgrey">
      <color rgba="0.402 0.402 0.402 0.9"/>
  </material>

  <!--links-->
  <link name="base_link">
    <inertial>
      <mass value="100.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <origin rpy="0.0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size='1 0.5 0.2'/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0.0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size='1 0.5 0.2'/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="left_wheel">
    <inertial>
      <mass value="5.0"/>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <origin rpy="1.5708  0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length='0.06' radius= '0.15'/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="1.5708  0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length='0.06' radius= '0.15'/>
      </geometry>
      <material name="darkgrey"/>
    </visual>
  </link>  

  <link name="right_wheel">
    <inertial>
      <mass value="5.0"/>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <origin rpy="1.5708  0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length='0.06' radius= '0.15'/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="1.5708  0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length='0.06' radius= '0.15'/>
      </geometry>
      <material name="darkgrey"/>
    </visual>
  </link>   

  <link name="front_wheel">
    <inertial>
      <mass value="5.0"/>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <origin rpy="1.5708  0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length='0.06' radius= '0.15'/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="1.5708  0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length='0.06' radius= '0.15'/>
      </geometry>
      <material name="darkgrey"/>
    </visual>
  </link>  

    <link name="stairs">
    <inertial>
      <mass value="5.0"/>
      <origin rpy="0 0 0" xyz="0.25 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <origin rpy="0.0 0 0" xyz="0.25 0 0"/>
      <geometry>
        <box size='0.5 0.2 0.05'/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0.0 0 0" xyz="0.25 0 0"/>
      <geometry>
        <box size='0.5 0.2 0.05'/>
      </geometry>
      <material name="lightgrey"/>
    </visual>
  </link>  

  <link name="stairs_base">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length='0.05' radius= '0.15'/>
        </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length='0.05' radius= '0.15'/>
      </geometry>
      <material name="lightgrey"/>
    </visual>
  </link>

  <link name="stairs_extension">
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.2" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.2 0.05"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.2 0.05"/>
      </geometry>
      <material name="lightgrey"/>
    </visual>
  </link>

  <!--joints-->

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.28 -0.4 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="20"/>
  </joint>


  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.28 0.4 0" rpy="0 0 0"/>
    <axis xyz="0 1 0" rpy="0 0 0"/>
    <limit effort="100" velocity="20"/>
  </joint>

  <joint name="front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_wheel"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="20"/>
  </joint>

  <joint name="rotation_joint" type="continuous">
    <parent link="base_link"/>
    <child link="stairs_base"/>
    <origin xyz="-0.25 0 0.125" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="20"/>
  </joint>

  <joint name="tilt_joint" type="revolute">
    <parent link="stairs_base"/>
    <child link="stairs"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" lower="-1.5708" upper="0" velocity="1.0"/> 
  </joint>

  <joint name="extend_joint" type="prismatic">
    <parent link="stairs"/>
    <child link="stairs_extension"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="50" lower="0" upper="2" velocity="1.0"/> 
  </joint>

</robot>